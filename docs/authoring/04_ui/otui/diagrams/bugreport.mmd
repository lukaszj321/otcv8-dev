%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Definition["Widget Definition"]
        A[OTUI File] --> B[Bugreport]
        B --> C[Parse Properties]
        C --> D[Create Instance]
    end

    subgraph Structure["Widget Structure"]
        D --> E[Layout Rules]
        D --> F[Style Properties]
        D --> G[Event Bindings]
    end

    subgraph Rendering["Rendering"]
        E --> H[Calculate Geometry]
        F --> I[Apply Styles]
        H --> J[Position Widget]
        I --> J
        J --> K[Draw to Screen]
    end

    subgraph Interaction["User Interaction"]
        L[User Input] --> M{Event Type?}
        M -.Click.-> N[onClick Handler]
        M -.Hover.-> O[onHover Handler]
        M -.Key.-> P[onKey Handler]
        N --> Q[Lua Callback]
        O --> Q
        P --> Q
    end

    subgraph Updates["Dynamic Updates"]
        Q --> R[Update State]
        R --> H
        S[Data Change] --> R
    end

    style B fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style K fill:#27ae60,stroke:#fff,stroke-width:2px
    style Q fill:#e67e22,stroke:#fff,stroke-width:2px
