%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Creation["FBO Creation"]
        A[Create Framebuffer] --> B[Attach Texture]
        B --> C[Attach Depth Buffer]
        C --> D[Check Completeness]
    end

    subgraph Rendering["Render to Texture"]
        D --> E[Bind FBO]
        E --> F[Set Viewport]
        F --> G[Draw Scene]
        G --> H[Unbind FBO]
    end

    subgraph Usage["Texture Usage"]
        H --> I[FBO Texture]
        I --> J[Post-Processing]
        I --> K[UI Rendering]
        I --> L[Effects<br/>(Blur, Glow)]
    end

    subgraph Output["Final Output"]
        J --> M[Screen FBO]
        K --> M
        L --> M
        M --> N[Display]
    end

    style E fill:#8e44ad,stroke:#fff,stroke-width:2px
    style I fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style N fill:#27ae60,stroke:#fff,stroke-width:2px
