%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Creation["1. FBO Creation"]
        direction LR
        A["fa:fa-plus Create<br/>Framebuffer"] --> B["fa:fa-image Attach Color<br/>Texture"]
        B --> C["fa:fa-layer-group Attach Depth<br/>Buffer"]
        C --> D["fa:fa-check-circle Check<br/>Completeness"]
    end

    subgraph Rendering["2. Render to Texture"]
        direction TB
        D --> E["fa:fa-link Bind<br/>FBO"]
        E --> F["fa:fa-expand Set<br/>Viewport"]
        F --> G["fa:fa-paint-brush Draw<br/>Scene"]
        G --> H["fa:fa-unlink Unbind<br/>FBO"]
    end

    subgraph Texture["3. Texture Access"]
        direction TB
        H --> I["fa:fa-file-image FBO<br/>Texture"]
        I --> J["fa:fa-magic Post-<br/>Processing"]
        I --> K["fa:fa-th UI<br/>Rendering"]
        I --> L["fa:fa-star Effects<br/>Blur, Glow"]
    end

    subgraph Output["4. Final Composition"]
        direction LR
        J --> M["fa:fa-desktop Screen<br/>FBO"]
        K --> M
        L --> M
        M --> N["fa:fa-tv Display<br/>Output"]
    end

    %% Architectural Layer Colors
    classDef core fill:#3498db,stroke:#fff,stroke-width:2px
    
    %% Apply styles
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N core
