%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#e5e7eb','lineColor':'#4b5563','fontFamily':'Inter, system-ui, sans-serif'},'securityLevel':'loose'}}%%
graph TD
    subgraph Queue["1. Task Queue"]
        direction LR
        A["fa:fa-code Main<br/>Thread"] -- enqueue --> B["fa:fa-list Task<br/>Queue"]
        C["fa:fa-network-wired Network<br/>Thread"] -- enqueue --> B
        D["fa:fa-gamepad Game<br/>Thread"] -- enqueue --> B
    end

    subgraph Dispatcher["2. Async Dispatcher"]
        direction TB
        B --> E["fa:fa-cogs AsyncDispatcher"]
        E --> F{"fa:fa-clock Scheduling"}
        F -.immediate.-> G["fa:fa-bolt Execute<br/>Now"]
        F -.delayed.-> H["fa:fa-hourglass Schedule<br/>Later"]
        F -.periodic.-> I["fa:fa-redo Repeat<br/>Interval"]
    end

    subgraph Execution["3. Task Execution"]
        direction TB
        G --> J["fa:fa-microchip Worker<br/>Thread"]
        H --> J
        I --> J
        J --> K["fa:fa-play Execute<br/>Task"]
        K --> L["fa:fa-check Task<br/>Complete"]
    end

    subgraph Callback["4. Result Handling"]
        direction LR
        L --> M["fa:fa-bell Callback<br/>Notification"]
        M --> N["fa:fa-arrow-left Return to<br/>Main Thread"]
        N --> O["fa:fa-sync Update<br/>Application"]
    end

    %% Architectural Layer Colors
    classDef core fill:#3498db,stroke:#fff,stroke-width:2px
    
    %% Apply styles
    class B,E,F,G,H,I,J,K,L,M,N,O core
