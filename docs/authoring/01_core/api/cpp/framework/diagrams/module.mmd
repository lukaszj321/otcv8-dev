%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Discovery["Module Discovery"]
        A[Scan Directories] --> B[Find .otmod Files]
        B --> C[Parse Manifest]
        C --> D[Check Dependencies]
    end

    subgraph Loading["Module Loading"]
        D --> E{Dependencies Met?}
        E -.Yes.-> F[Load Module]
        E -.No.-> G[Wait/Skip]
        F --> H[Execute init.lua]
    end

    subgraph Runtime["Runtime Integration"]
        H --> I[Register Functions]
        I --> J[Bind UI Elements]
        J --> K[Register Events]
        K --> L[Module Active]
    end

    subgraph Unloading["Module Unloading"]
        L -.Terminate.-> M[Execute terminate.lua]
        M --> N[Cleanup Resources]
        N --> O[Unregister]
    end

    style F fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style L fill:#27ae60,stroke:#fff,stroke-width:2px
    style M fill:#e74c3c,stroke:#fff,stroke-width:2px
