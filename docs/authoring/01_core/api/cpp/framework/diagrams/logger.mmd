%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Input["Log Input"]
        A["Log Message"] --> B{Log Level}
        B -.DEBUG.-> C[Logger]
        B -.INFO.-> C
        B -.WARNING.-> C
        B -.ERROR.-> C
    end

    subgraph Processing["Message Processing"]
        C --> D["Format Message"]
        D --> E["Add Timestamp"]
        E --> F["Add Context"]
    end

    subgraph Output["Log Output"]
        F --> G["Console Output"]
        F --> H["File Output<br/>(otclient.log)"]
        F --> I["In-Game Terminal"]
        F --> J["Callbacks<br/>(Lua Handlers)"]
    end

    subgraph Management["Log Management"]
        H --> K["Log Rotation"]
        K --> L["Archive Old Logs"]
    end

    style C fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style G fill:#27ae60,stroke:#fff,stroke-width:2px
    style H fill:#e67e22,stroke:#fff,stroke-width:2px
