        A["Start Application"] --> B["Initialize Core Systems"]
        B --> C["Load Configuration"]
        C --> D["Initialize Window & Graphics"]
        D --> E["Load Resources"]
        E --> F["Load Modules"]
    end

    subgraph MainLoop["Main Loop"]
        direction TB
        G["Enter Main Loop"] --> H{Event Polling}
