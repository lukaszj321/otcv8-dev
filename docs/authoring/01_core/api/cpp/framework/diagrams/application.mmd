        K["Shutdown Signal"] --> L["Terminate"]
    end

    F --> G
    G -.Exit.-> K

    style G fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style H fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style I fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style J fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style A fill:#2d5016,stroke:#4a7f2a
    style K fill:#3d1f1f,stroke:#6b3535
