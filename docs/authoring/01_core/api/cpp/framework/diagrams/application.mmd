%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#e5e7eb','lineColor':'#4b5563','fontFamily':'Inter, system-ui, sans-serif'},'securityLevel':'loose'}}%%
graph TD
    %% Architectural Layer Colors
    classDef core fill:#3498db,stroke:#fff,color:#fff
    classDef subsystem fill:#2ecc71,stroke:#111827,color:#111827
    classDef game fill:#e67e22,stroke:#fff,color:#fff
    classDef critical fill:#e74c3c,stroke:#fff,color:#fff
    
    subgraph Initialization["fa:fa-power-off 1. Initialization Phase"]
        direction LR
        A["fa:fa-cogs Start<br/>Application"]:::core
        B["fa:fa-cogs Initialize<br/>Core Systems"]:::core
        C["fa:fa-file-alt Load<br/>Configuration"]:::core
        D["fa:fa-desktop Initialize<br/>Window &amp; Graphics"]:::core
        E["fa:fa-folder-open Load<br/>Resources"]:::subsystem
        F["fa:fa-puzzle-piece Load<br/>Modules"]:::game
        
        A -- "Bootstrap" --> B
        B -- "Read settings" --> C
        C -- "Create context" --> D
        D -- "Load assets" --> E
        E -- "Discover & init" --> F
    end

    subgraph MainLoop["fa:fa-sync-alt 2. Main Loop"]
        direction TB
        G["fa:fa-cogs Enter<br/>Main Loop"]:::core
        H{"fa:fa-bolt Event<br/>Polling?"}:::core
        I["fa:fa-calculator Update<br/>Logic"]:::game
        J["fa:fa-paint-brush Render<br/>Frame"]:::core
        
        G -- "Poll OS events" --> H
        H -- "Process inputs" --> I
        I -- "Draw scene" --> J
        J -- "Next iteration" --> G
    end

    subgraph Shutdown["fa:fa-sign-out-alt 3. Shutdown Phase"]
        direction LR
        K["fa:fa-exclamation-triangle Shutdown<br/>Signal"]:::core
        L["fa:fa-stop Cleanup<br/>Resources"]:::subsystem
        M["fa:fa-power-off Terminate"]:::core
        
        K -- "Graceful exit" --> L
        L -- "Final cleanup" --> M
    end

    F -- "Ready to run" --> G
    G -.->|"Exit condition met"| K

    linkStyle 0,1,2,3,4,5 stroke:#3498db,stroke-width:2px
    linkStyle 6,7,8,9 stroke:#e67e22,stroke-width:2px
    linkStyle 10,11 stroke:#c0392b,stroke-width:2px
    linkStyle 12,13 stroke:#9aa0a6,stroke-width:1px,stroke-dasharray:3
