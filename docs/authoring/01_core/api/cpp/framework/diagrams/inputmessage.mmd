%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Receive["Message Receipt"]
        A[Network Data] --> B[Input Buffer]
        B --> C[InputMessage]
    end

    subgraph Reading["Data Reading"]
        C --> D[Read Header]
        D --> E{Packet Type?}
        E --> F[Read U8/U16/U32]
        E --> G[Read String]
        E --> H[Read Position]
        E --> I[Read Custom Data]
    end

    subgraph Processing["Message Processing"]
        F --> J[Parse Game Data]
        G --> J
        H --> J
        I --> J
        J --> K[Update Game State]
    end

    subgraph Validation["Data Validation"]
        C --> L[Check Size]
        D --> M[Verify Checksum]
        M -.Invalid.-> N[Discard]
        M -.Valid.-> E
    end

    style C fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style K fill:#27ae60,stroke:#fff,stroke-width:2px
    style N fill:#e74c3c,stroke:#fff,stroke-width:2px
