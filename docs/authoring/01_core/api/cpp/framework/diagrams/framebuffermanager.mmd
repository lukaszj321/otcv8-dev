%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Initialization["Initialization"]
        A[System Start] --> B[Framebuffermanager<br/>Singleton]
        B --> C[Load Configuration]
        C --> D[Initialize Resources]
    end

    subgraph Management["Resource Management"]
        D --> E[Create Resources]
        E --> F[Cache/Store]
        F --> G[Retrieve/Query]
        G --> H[Update/Modify]
    end

    subgraph Lifecycle["Resource Lifecycle"]
        E --> I[Active Resources]
        I --> J[Reference Counting]
        J -.No Refs.-> K[Cleanup/Release]
    end

    subgraph Operations["Operations"]
        G --> L[Query Operations]
        H --> M[Modify Operations]
        K --> N[Cleanup Operations]
    end

    style B fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style F fill:#8e44ad,stroke:#fff,stroke-width:2px
    style I fill:#27ae60,stroke:#fff,stroke-width:2px
