%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Establishment["Connection Establishment"]
        A["Connect Request"] --> B{DNS Lookup}
        B --> C["TCP Socket"]
        C --> D["TLS Handshake"]
        D --> E[Connected]
    end

    subgraph Communication["Data Communication"]
        E --> F["Send Messages"]
        E --> G["Receive Messages"]
        F --> H[Output Buffer]
        H --> I["Network Send"]
        J["Network Receive"] --> K[Input Buffer]
        K --> G
    end

    subgraph Protocol["Protocol Layer"]
        F -.Uses.-> L["Protocol Handler"]
        G -.Uses.-> L
        L --> M["Packet Encoding"]
        L --> N["Packet Decoding"]
    end

    subgraph Termination["Connection Termination"]
        E -.Error/Close.-> O["Disconnect"]
        O --> P["Cleanup"]
    end

    style E fill:#27ae60,stroke:#fff,stroke-width:2px
    style L fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style O fill:#e74c3c,stroke:#fff,stroke-width:2px
