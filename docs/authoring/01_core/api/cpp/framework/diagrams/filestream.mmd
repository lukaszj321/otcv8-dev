%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#e5e7eb','lineColor':'#4b5563','fontFamily':'Inter, system-ui, sans-serif'},'securityLevel':'loose'}}%%
graph LR
    subgraph Open["1. File Opening"]
        direction TB
        A["fa:fa-file Path<br/>Specification"] --> B{"fa:fa-question Access<br/>Mode"}
        B -.read.-> C["fa:fa-book Open<br/>Read"]
        B -.write.-> D["fa:fa-edit Open<br/>Write"]
        B -.append.-> E["fa:fa-plus Open<br/>Append"]
        C --> F["fa:fa-stream FileStream<br/>Object"]
        D --> F
        E --> F
    end

    subgraph Operations["2. Stream Operations"]
        direction TB
        F --> G["fa:fa-download Read<br/>Operations"]
        F --> H["fa:fa-upload Write<br/>Operations"]
        F --> I["fa:fa-compass Seek<br/>Position"]
        G --> J["fa:fa-align-left Read<br/>bytes, lines"]
        H --> K["fa:fa-pen Write<br/>data, strings"]
        I --> L["fa:fa-map-marker-alt Set<br/>Position"]
    end

    subgraph Buffering["3. Buffer Management"]
        direction TB
        J --> M["fa:fa-memory Internal<br/>Buffer"]
        K --> M
        M --> N["fa:fa-sync Flush<br/>to Disk"]
        N --> O["fa:fa-check Data<br/>Persisted"]
    end

    subgraph Close["4. Resource Cleanup"]
        direction LR
        F --> P["fa:fa-times Close<br/>Stream"]
        P --> Q["fa:fa-trash Release<br/>Resources"]
        Q --> R["fa:fa-lock File<br/>Unlocked"]
    end

    %% Architectural Layer Colors
    classDef core fill:#3498db,stroke:#fff,stroke-width:2px
    
    %% Apply styles
    class F,G,H,I,J,K,L,M,N,O,P,Q,R core
