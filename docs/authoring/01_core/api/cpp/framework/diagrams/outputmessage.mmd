%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Creation["Message Creation"]
        A[Game Event] --> B[OutputMessage]
        B --> C[Add Header]
    end

    subgraph Writing["Data Writing"]
        C --> D[Write U8/U16/U32]
        C --> E[Write String]
        C --> F[Write Position]
        C --> G[Write Custom Data]
    end

    subgraph Preparation["Message Preparation"]
        D --> H[Calculate Size]
        E --> H
        F --> H
        G --> H
        H --> I[Add Checksum]
        I --> J[Encrypt if needed]
    end

    subgraph Sending["Message Sending"]
        J --> K[Output Buffer]
        K --> L[Connection Send]
        L --> M[Network Transmit]
    end

    style B fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style K fill:#8e44ad,stroke:#fff,stroke-width:2px
    style M fill:#27ae60,stroke:#fff,stroke-width:2px
