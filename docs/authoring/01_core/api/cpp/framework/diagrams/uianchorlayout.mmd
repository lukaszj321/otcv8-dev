%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Configuration["Layout Configuration"]
        A[Widget Tree] --> B[Uianchorlayout]
        B --> C[Parse Rules]
    end

    subgraph Calculation["Layout Calculation"]
        C --> D[Measure Widgets]
        D --> E[Calculate Positions]
        E --> F[Calculate Sizes]
        F --> G[Apply Constraints]
    end

    subgraph Application["Apply Layout"]
        G --> H[Update Widget Geometry]
        H --> I[Position Children]
        I --> J[Trigger Render]
    end

    subgraph Updates["Dynamic Updates"]
        K[Widget Added/Removed] --> D
        L[Window Resize] --> D
        M[Content Change] --> D
    end

    style B fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style G fill:#8e44ad,stroke:#fff,stroke-width:2px
    style J fill:#27ae60,stroke:#fff,stroke-width:2px
