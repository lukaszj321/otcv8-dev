%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Loading["Sound Loading"]
        A["Sound File<br/>(OGG)"] --> B["Decode Audio"]
        B --> C["Sound Buffer"]
    end

    subgraph Playback["Sound Playback"]
        C --> D["Create Source"]
        D --> E{Source Type}
        E -.Static.-> F["Buffer Source"]
        E -.Streaming.-> G["Stream Source"]
    end

    subgraph Mixing["Audio Mixing"]
        F --> H["Audio Mixer"]
        G --> H
        H --> I["Channel Management"]
        I --> J["Volume Control"]
    end

    subgraph Output["Audio Output"]
        J --> K["OpenAL Backend"]
        K --> L["Audio Device"]
        L --> M["Speakers/Headphones"]
    end

    style C fill:#8e44ad,stroke:#fff,stroke-width:2px
    style H fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style K fill:#e67e22,stroke:#fff,stroke-width:2px
    style M fill:#27ae60,stroke:#fff,stroke-width:2px
