%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Loading["Texture Loading"]
        A["Image File<br/>(PNG/BMP)"] --> B["Load from Disk"]
        B --> C["Decode Image Data"]
        C --> D[Texture Object]
    end

    subgraph GPU["GPU Management"]
        D --> E["Upload to GPU"]
        E --> F["Texture ID<br/>(OpenGL)"]
        F --> G["Bind to Texture Unit"]
    end

    subgraph Rendering["Rendering Pipeline"]
        G --> H["Shader Access"]
        H --> I["Fragment Sampling"]
        I --> J["Rendered Output"]
    end

    subgraph Memory["Memory Management"]
        D --> K["CPU Memory"]
        F --> L["GPU Memory"]
        L -.Cleanup.-> M["Release Resources"]
    end

    style D fill:#8e44ad,stroke:#fff,stroke-width:2px
    style F fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style J fill:#27ae60,stroke:#fff,stroke-width:2px
