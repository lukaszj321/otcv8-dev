%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Client["Client Side"]
        A[Game Action] --> B[Create Packet]
        B --> C[Encode Message]
        C --> D[Send to Server]
    end

    subgraph Network["Network Layer"]
        D --> E[Connection]
        E --> F[Encryption/Compression]
        F --> G[TCP/IP]
    end

    subgraph Server["Server Side"]
        G --> H[Receive Packet]
        H --> I[Decrypt/Decompress]
        I --> J[Decode Message]
        J --> K[Process Request]
        K --> L[Send Response]
    end

    subgraph Response["Response Handling"]
        L --> E
        E --> M[Client Receives]
        M --> N[Decode Response]
        N --> O[Update Game State]
    end

    style E fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style K fill:#e67e22,stroke:#fff,stroke-width:2px
    style O fill:#27ae60,stroke:#fff,stroke-width:2px
