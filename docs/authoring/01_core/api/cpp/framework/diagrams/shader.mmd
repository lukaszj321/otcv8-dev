%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Loading["Shader Loading"]
        A[Vertex Shader<br/>Source] --> B[Compile]
        C[Fragment Shader<br/>Source] --> D[Compile]
        B --> E[Link Program]
        D --> E
    end

    subgraph Uniforms["Uniform Management"]
        E --> F[Query Uniforms]
        F --> G[Set Matrices]
        F --> H[Set Textures]
        F --> I[Set Colors]
        F --> J[Set Custom Values]
    end

    subgraph Rendering["Shader Usage"]
        E --> K[Bind Shader]
        G --> K
        H --> K
        I --> K
        J --> K
        K --> L[Draw Call]
        L --> M[GPU Execution]
    end

    subgraph Pipeline["Graphics Pipeline"]
        M --> N[Vertex Processing]
        N --> O[Rasterization]
        O --> P[Fragment Processing]
        P --> Q[Output Pixels]
    end

    style E fill:#8e44ad,stroke:#fff,stroke-width:2px
    style K fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style M fill:#e67e22,stroke:#fff,stroke-width:2px
