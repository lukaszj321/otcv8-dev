%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Loading["Configuration Loading"]
        A[Config File] --> B[Parse Otmlnode]
        B --> C[Validate Structure]
        C --> D[Build Tree]
    end

    subgraph Access["Data Access"]
        D --> E[Read Values]
        E --> F[Type Conversion]
        F --> G[Return to Application]
    end

    subgraph Modification["Modification"]
        H[Update Values] --> D
        I[Add Nodes] --> D
        J[Remove Nodes] --> D
    end

    subgraph Persistence["Save Configuration"]
        D --> K[Serialize]
        K --> L[Format Output]
        L --> M[Write to File]
    end

    style D fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style E fill:#8e44ad,stroke:#fff,stroke-width:2px
    style M fill:#27ae60,stroke:#fff,stroke-width:2px
