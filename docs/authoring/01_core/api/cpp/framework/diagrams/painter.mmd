graph TD
    subgraph Setup["Drawing Setup"]
        A["Set Color"] --> B[Painter State]
        C["Set Texture"] --> B
        D["Set Shader"] --> B
        E["Set Clip Rect"] --> B
    end

    subgraph Drawing["Drawing Operations"]
        B --> F["Draw Rectangle"]
        B --> G["Draw Textured Rect"]
        B --> H["Draw Triangle"]
        B --> I["Draw Line"]
        B --> J["Draw Text"]
    end

    subgraph Batching["Render Batching"]
        F --> K[Geometry Buffer]
        G --> K
        H --> K
        I --> K
        J --> L[Text Buffer]
        K --> M["Batch Draw Call"]
        L --> M
    end

    subgraph Output["Final Output"]
        M --> N["OpenGL Commands"]
        N --> O["Frame Buffer"]
        O --> P["Screen Display"]
    end

    style B fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style K fill:#8e44ad,stroke:#fff,stroke-width:2px
    style M fill:#e67e22,stroke:#fff,stroke-width:2px
    style P fill:#27ae60,stroke:#fff,stroke-width:2px
