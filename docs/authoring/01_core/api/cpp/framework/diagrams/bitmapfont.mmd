%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Loading["Font Loading"]
        A[Font File<br/>(.otfont)] --> B[Parse Metadata]
        B --> C[Load Glyph Atlas]
        C --> D[BitmapFont Object]
    end

    subgraph Glyphs["Glyph Data"]
        D --> E[Glyph Positions]
        D --> F[Glyph Sizes]
        D --> G[Kerning Data]
        D --> H[Texture Atlas]
    end

    subgraph Rendering["Text Rendering"]
        I[Text String] --> J[Calculate Layout]
        E --> J
        F --> J
        G --> J
        J --> K[Generate Quads]
        K --> L[Texture Coords]
        H --> L
        L --> M[Draw Text]
    end

    subgraph Output["Rendered Text"]
        M --> N[Text on Screen]
    end

    style D fill:#8e44ad,stroke:#fff,stroke-width:2px
    style K fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style N fill:#27ae60,stroke:#fff,stroke-width:2px
