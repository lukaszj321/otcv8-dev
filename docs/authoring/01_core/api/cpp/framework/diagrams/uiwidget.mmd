%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Hierarchy["Widget Hierarchy"]
        A[UIWidget<br/>Base Class] --> B[UIWindow]
        A --> C[UIButton]
        A --> D[UILabel]
        A --> E[UITextEdit]
        A --> F[UIList]
    end

    subgraph Lifecycle["Widget Lifecycle"]
        G[Create] --> H[Add to Parent]
        H --> I[Layout]
        I --> J[Show/Visible]
        J --> K[Render]
        K -.Update.-> I
        J -.Hide.-> L[Destroy]
    end

    subgraph Events["Event Flow"]
        M[User Input] --> N{Event Handler}
        N --> O[Widget Handler]
        O --> P[Lua Callback]
        P --> Q[State Update]
    end

    A -.Instance.-> G
    Q -.Triggers.-> K

    style A fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style J fill:#27ae60,stroke:#fff,stroke-width:2px
    style P fill:#e67e22,stroke:#fff,stroke-width:2px
