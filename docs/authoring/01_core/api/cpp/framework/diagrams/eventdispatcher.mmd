%%{init: {'theme':'dark','themeVariables': {'primaryTextColor':'#ddd','lineColor':'#9aa0a6'},'securityLevel':'loose'}}%%
graph TD
    subgraph Sources["Event Sources"]
        A["Input Events"] --> B[Event Queue]
        C["Network Events"] --> B
        D["Timer Events"] --> B
        E["UI Events"] --> B
    end

    subgraph Processing["Event Processing"]
        B --> F{Event Type}
        F -.Keyboard.-> G["Input Handler"]
        F -.Mouse.-> G
        F -.Network.-> H["Network Handler"]
        F -.Timer.-> I["Timer Handler"]
        F -.UI.-> J["UI Handler"]
    end

    subgraph Dispatch["Event Dispatch"]
        G --> K["C++ Callbacks"]
        H --> K
        I --> K
        J --> K
        K --> L["Lua Event Handlers"]
    end

    subgraph Results["Event Results"]
        L --> M["State Updates"]
        M --> N["Render Updates"]
        M --> O["Network Responses"]
    end

    style B fill:#8e44ad,stroke:#fff,stroke-width:2px
    style F fill:#2a7f9c,stroke:#fff,stroke-width:2px
    style L fill:#e67e22,stroke:#fff,stroke-width:2px
