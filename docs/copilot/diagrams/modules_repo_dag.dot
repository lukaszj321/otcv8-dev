  @onLoad: init()
  @onUnload: terminate()" -> "game_bot" [label="load-later"];
  "updater
  description: Updates client
  author: otclient@otclient.ovh
  website: otclient.ovh
  reloadable: false
  scripts: [ updater ]
  dependencies: [ client_locales, client_styles, client_textedit ]
  @onUnload: Updater.terminate()
  
  load-later:
    - client_background" -> "client_background" [label="load-later"];
}