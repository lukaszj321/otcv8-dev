graph LR
    Start("🚀 Application Start") --> client("1. Initialize Core Client");

    subgraph Phase_1_Pre-Game_Modules
        client -- loads --> client_styles & client_locales & client_topmenu & client_background & client_textedit & client_options & client_terminal & client_stats & client_feedback & client_mobile & client_entergame;
    end
    
    client --> Phase_1_Pre-Game_Modules;

    Phase_1_Pre-Game_Modules --> client_entergame_init("2. Initialize Enter Game");

    subgraph Phase_2_Game_Data
        client_entergame_init -- loads --> game_things & game_features;
    end

    client_entergame_init --> Phase_2_Game_Data;

    Phase_2_Game_Data --> game_interface("3. Initialize Game Interface");

    subgraph Phase_3_All_UI_Modules
        %% Tutaj tworzymy zagnieżdżone grupy dla lepszej organizacji wizualnej
        subgraph Player_Info
            game_healthinfo & game_skills & game_stats_ui[game_stats] & game_outfit & game_playermount;
        end
        subgraph Item_Management
            game_inventory & game_containers & game_shop & game_market & game_npctrade & game_playertrade & game_itemselector;
        end
        subgraph Interaction_Controls
            game_buttons & game_hotkeys & game_actionbar & game_walking & game_battle;
        end
        subgraph Gameplay_Systems
             game_questlog & game_prey & game_imbuing & game_spelllist & game_cooldown;
        end
        subgraph Windows_Dialogs
            game_viplist & game_minimap & game_modaldialog & game_textwindow & client_profiles;
        end
        subgraph Communication
            game_console & game_textmessage & game_bugreport & game_ruleviolation;
        end
        subgraph Advanced_Misc
            game_shaders & game_bot & game_playerdeath & game_unjustifiedpoints;
        end
    end

    %% Zgrupowane połączenia dla czytelności
    game_interface -- "loads player UI" --> Player_Info;
    game_interface -- "loads item UI" --> Item_Management;
    game_interface -- "loads controls" --> Interaction_Controls;
    game_interface -- "loads systems UI" --> Gameplay_Systems;
    game_interface -- "loads windows" --> Windows_Dialogs;
    game_interface -- "loads comms UI" --> Communication;
    game_interface -- "loads advanced" --> Advanced_Misc;

    Phase_3_All_UI_Modules --> Ready("✅ Client Ready to Play");

    subgraph Parallel_Utility_Updater
        updater_init("Initialize Updater");
        %% Połączenia z modułów z Fazy 1
        client_locales --> updater_init;
        client_styles --> updater_init;
        client_textedit --> updater_init;
        updater_init -- loads --> client_background;
    end
