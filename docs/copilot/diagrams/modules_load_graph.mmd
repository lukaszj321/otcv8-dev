%%{init: {"theme":"dark"}}%%
graph LR
    %% ===================================================================
    %% DEFINICJE STYLÓW - WIĘKSZE I BARDZIEJ CZYTELNE
    %% ===================================================================
    classDef core fill:#004a99,color:#fff,stroke:#3399ff,stroke-width:2px,font-weight:bold,font-size:14px;
    classDef client_module fill:#4B0082,color:#fff,stroke:#9932CC,font-size:12px;
    classDef game_logic fill:#792e00,color:#fff,stroke:#c26d39,font-size:14px;
    classDef game_ui fill:#00504b,color:#fff,stroke:#33b3a9,font-size:12px;
    classDef utility fill:#614a00,color:#fff,stroke:#a68333;
    classDef container fill:#222,stroke:#888,stroke-dasharray: 5 5;
    classDef invisible stroke-width:0px,color:#1a1a1a;

    %% ===================================================================
    %% GŁÓWNE STREFY ARCHITEKTONICZNE
    %% ===================================================================

    subgraph Strefa_Modułów_Klienta [Moduły Klienta i Narzędzia]
        %% BRAK 'direction'. Układ pionowy wymuszony przez połączenie.
        subgraph Utilities
            updater;
        end
        subgraph Moduły_Wspólne
            client_styles & client_locales & client_textedit & client_background & client_options & client_terminal & client_stats & client_feedback & client_mobile;
        end
        Utilities --> Moduły_Wspólne;
    end

    subgraph Strefa_Rdzenia [Rdzeń Aplikacji]
        %% BRAK 'direction'.
        client;
    end
    
    subgraph Strefa_Logiki_Gry [Logika Gry]
        %% BRAK 'direction'. Układ pionowy wymuszony przez połączenie.
        client_entergame;
        subgraph Dane_Gry
            game_things & game_features;
        end
        client_entergame --> Dane_Gry;
    end

    subgraph Strefa_Interfejsu_Gry [Interfejs Gry i jego Moduły]
        %% BRAK 'direction'. Układ pionowy wymuszony przez połączenie.
        game_interface;
        subgraph Moduły_UI
            %% Zagnieżdżone grupy dla czytelności.
            subgraph Player_Info
                game_healthinfo & game_skills & game_stats_ui[game_stats] & game_outfit;
            end
            subgraph Item_Management
                game_inventory & game_containers & game_shop & game_market;
            end
            subgraph Interaction
                game_buttons & game_hotkeys & game_actionbar & game_battle;
            end
        end
        game_interface -- "wymaga modułów UI" --> Moduły_UI;
    end

    %% ===================================================================
    %% KONTROLA UKŁADU - TWORZENIE POZIOMYCH "TORÓW"
    %% ===================================================================
    subgraph невидимка [ ]
      Strefa_Modułów_Klienta ~~~ Strefa_Rdzenia ~~~ Strefa_Logiki_Gry ~~~ Strefa_Interfejsu_Gry;
    end
    class невидимка invisible;

    %% ===================================================================
    %% GŁÓWNE POŁĄCZENIA MIĘDZY STREFAMI
    %% ===================================================================
    Strefa_Rdzenia -- "wykorzystuje" --> Strefa_Modułów_Klienta;
    Strefa_Rdzenia -- "uruchamia" --> Strefa_Logiki_Gry;
    Strefa_Logiki_Gry -- "uruchamia" --> Strefa_Interfejsu_Gry;
    
    %% Zależności updatgera
    updater -- "zależy od" --> client_locales & client_styles & client_textedit;

    %% ===================================================================
    %% PRZYPISANIE STYLÓW
    %% ===================================================================
    class client,game_interface core;
    class client_entergame game_logic;
    class client_styles,client_locales,client_textedit,client_background,client_options,client_terminal,client_stats,client_feedback,client_mobile client_module;
    class game_things,game_features game_logic;
    class game_healthinfo,game_skills,game_stats_ui,game_outfit,game_inventory,game_containers,game_shop,game_market,game_buttons,game_hotkeys,game_actionbar,game_battle game_ui;
    class updater utility;
    class Strefa_Rdzenia,Strefa_Modułów_Klienta,Strefa_Logiki_Gry,Strefa_Interfejsu_Gry,Utilities,Moduły_Wspólne,Dane_Gry,Moduły_UI,Player_Info,Item_Management,Interaction container;
