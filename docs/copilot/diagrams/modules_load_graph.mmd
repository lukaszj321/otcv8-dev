%%{init: {"theme":"dark"}}%%
graph LR
    %% ===================================================================
    %% DEFINICJE STYLÓW - HIERARCHIA WIZUALNA
    %% ===================================================================
    classDef sun fill:#004a99,color:#fff,stroke:#3399ff,stroke-width:3px,font-weight:bold,font-size:18px;
    classDef planet fill:#222,stroke:#888,stroke-dasharray: 5 5;
    classDef client_module fill:#4B0082,color:#fff,stroke:#9932CC;
    classDef game_logic fill:#792e00,color:#fff,stroke:#c26d39;
    classDef game_ui fill:#00504b,color:#fff,stroke:#33b3a9;
    classDef utility fill:#614a00,color:#fff,stroke:#a68333;
    classDef invisible stroke-width:0px,color:#1a1a1a;

    %% ===================================================================
    %% SŁOŃCE - CENTRALNY PUNKT ARCHITEKTURY
    %% ===================================================================
    subgraph central_node [ ]
      client;
    end
    style central_node fill:none,stroke:none

    %% ===================================================================
    %% PLANETY - GŁÓWNE STREFY ODPOWIEDZIALNOŚCI
    %% ===================================================================
    
    subgraph Warstwa_Modułów_Klienta
        %% BRAK 'direction'. Układ poziomy jest domyślny dla 'graph LR'
        client_styles & client_locales & client_textedit & client_background & client_options & client_terminal & client_stats & client_feedback & client_mobile;
    end

    subgraph Utilities
        updater;
    end
    
    subgraph Warstwa_Logiki_Gry
        %% BRAK 'direction'. Układ pionowy jest wymuszony przez jawne połączenie.
        client_entergame;
        subgraph Dane_Gry
            game_things & game_features;
        end
        client_entergame --> Dane_Gry;
    end

    subgraph Świat_Gry
        %% BRAK 'direction'. Układ pionowy jest wymuszony przez jawne połączenie.
        game_interface;
        subgraph Moduły_UI
            %% Zagnieżdżone grupy dla czytelności.
            subgraph Player_Info
                game_healthinfo & game_skills & game_stats_ui[game_stats];
            end

            subgraph Item_Management
                game_inventory & game_containers & game_shop;
            end
        end
        game_interface -- "wymaga" --> Moduły_UI;
    end

    %% ===================================================================
    %% POŁĄCZENIA - PRZEPŁYW MOCY
    %% ===================================================================
    client -- "wykorzystuje ◀" --> Warstwa_Modułów_Klienta;
    client -- "uruchamia ▶" --> Warstwa_Logiki_Gry;
    client_entergame -- "tworzy 💥" --> Świat_Gry;
    updater -- "zależy od" --> client_locales & client_styles & client_textedit;
    
    %% ===================================================================
    %% KONTROLA UKŁADU - ROZMIESZCZENIE PLANET
    %% ===================================================================
    subgraph невидимка [ ]
      Warstwa_Modułów_Klienta ~~~ client ~~~ Utilities
      client ~~~ Warstwa_Logiki_Gry
      Warstwa_Logiki_Gry ~~~ Świat_Gry
    end
    class невидимка invisible;

    %% ===================================================================
    %% PRZYPISANIE STYLÓW
    %% ===================================================================
    class client sun;
    class Warstwa_Modułów_Klienta,Warstwa_Logiki_Gry,Utilities,Świat_Gry,Dane_Gry,Moduły_UI,Player_Info,Item_Management planet;
    class client_styles,client_locales,client_textedit,client_background,client_options,client_terminal,client_stats,client_feedback,client_mobile client_module;
    class client_entergame,game_things,game_features game_logic;
    class game_interface game_logic;
    class game_healthinfo,game_skills,game_stats_ui,game_inventory,game_containers,game_shop game_ui;
    class updater utility;
