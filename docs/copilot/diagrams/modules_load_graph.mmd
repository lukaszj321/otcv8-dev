%%{init: {"theme":"dark", "flowchart": {"curve": "basis"}}}%%
graph TD
    %% ===================================================================
    %% DEFINICJE STYLÓW
    %% ===================================================================
    classDef orchestrator fill:#004a99,color:#fff,stroke:#3399ff,stroke-width:2px,font-weight:bold;
    classDef module fill:#4B0082,color:#fff,stroke:#9932CC;
    classDef finalState fill:#006400,color:#fff,stroke:#2E8B57,stroke-width:2px,font-weight:bold;
    classDef subgraphStyle fill:#1a1a1a,stroke:#888,stroke-dasharray: 5 5;

    %% ===================================================================
    %% STRUKTURA DIAGRAMU
    %% ===================================================================

    Start("🚀 Application Start") --> client("1. Core Client");

    client --> Phase1_Modules["Phase 1: Pre-Game Modules"];
    
    subgraph Phase1_Modules
        client_styles & client_locales & client_topmenu & client_background & client_textedit & client_options & client_terminal & client_stats & client_feedback & client_mobile & client_entergame;
    end
    
    Phase1_Modules --> client_entergame_init("2. Enter Game Logic");

    client_entergame_init --> Phase2_Game_Data["Phase 2: Game Data"];

    subgraph Phase2_Game_Data
        game_things & game_features;
    end
    
    Phase2_Game_Data --> game_interface("3. Game Interface");

    game_interface --> Phase3_UI_Modules["Phase 3: All Game UI Modules"];

    subgraph Phase3_UI_Modules
        game_buttons & game_hotkeys & game_questlog & game_textmessage & game_console & game_outfit & game_healthinfo & game_skills & game_inventory & game_containers & game_viplist & game_battle & game_minimap & game_npctrade & game_textwindow & game_playertrade & game_bugreport & game_playerdeath & game_playermount & game_ruleviolation & game_market & game_spelllist & game_cooldown & game_modaldialog & game_unjustifiedpoints & game_walking & game_shop & game_itemselector & client_profiles & game_actionbar & game_prey & game_imbuing & game_stats_ui[game_stats] & game_shaders & game_bot;
    end

    Phase3_UI_Modules --> Ready("✅ Client Ready to Play");

    subgraph Updater_Utility
        updater_init("Initialize Updater");
        client_locales --> updater_init;
        client_styles --> updater_init;
        client_textedit --> updater_init;
        updater_init -- loads --> client_background;
    end

    %% ===================================================================
    %% PRZYPISANIE STYLÓW
    %% ===================================================================
    class client,client_entergame_init,game_interface orchestrator;
    class Ready finalState;
    class Phase1_Modules,Phase2_Game_Data,Phase3_UI_Modules,Updater_Utility subgraphStyle;
    class client_styles,client_locales,client_topmenu,client_background,client_textedit,client_options,client_entergame,client_terminal,client_stats,client_feedback,client_mobile module;
    class game_things,game_features,updater_init module;
    class game_buttons,game_hotkeys,game_questlog,game_textmessage,game_console,game_outfit,game_healthinfo,game_skills,game_inventory,game_containers,game_viplist,game_battle,game_minimap,game_npctrade,game_textwindow,game_playertrade,game_bugreport,game_playerdeath,game_playermount,game_ruleviolation,game_market,game_spelllist,game_cooldown,game_modaldialog,game_unjustifiedpoints,game_walking,game_shop,game_itemselector,client_profiles,game_actionbar,game_prey,game_imbuing,game_stats_ui,game_shaders,game_bot module;
