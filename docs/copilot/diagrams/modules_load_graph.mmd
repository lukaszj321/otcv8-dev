%%{init: {"theme":"dark"}}%%
graph TD
    %% ===================================================================
    %% DEFINICJE STYLÓW
    %% ===================================================================
    classDef core fill:#004a99,color:#fff,stroke:#3399ff,stroke-width:2px,font-weight:bold;
    classDef client_module fill:#4B0082,color:#fff,stroke:#9932CC;
    classDef game_logic fill:#792e00,color:#fff,stroke:#c26d39;
    classDef game_ui fill:#00504b,color:#fff,stroke:#33b3a9;
    classDef utility fill:#614a00,color:#fff,stroke:#a68333;
    classDef container fill:#222,stroke:#888,stroke-dasharray: 5 5;
    classDef note fill:#333,color:#aaa,stroke:#555;

    %% ===================================================================
    %% WARSTWA 1: RDZEŃ APLIKACJI
    %% ===================================================================
    subgraph Warstwa_Rdzenia
        client;
    end

    %% ===================================================================
    %% WARSTWA 2: MODUŁY KLIENTA
    %% ===================================================================
    subgraph Warstwa_Modułów_Klienta
        direction LR
        client_styles & client_locales & client_textedit & client_background & client_options & client_terminal & client_stats & client_feedback & client_mobile;
    end
    client -- "zależy od" --> Warstwa_Modułów_Klienta;

    %% ===================================================================
    %% WARSTWA 3: LOGIKA GRY (POMOST)
    %% ===================================================================
    subgraph Warstwa_Logiki_Gry
        direction LR
        client_entergame & game_features & game_things;
    end
    client -- "zależy od" --> client_entergame;
    client_entergame -- "zależy od" --> game_features & game_things;

    %% ===================================================================
    %% WARSTWA 4: ŚWIAT GRY (GŁÓWNY KONTENER)
    %% ===================================================================
    subgraph Świat_Gry
        game_interface;

        subgraph Moduly_UI
            %% Ten węzeł zastępuje problematyczny tytuł
            note["(zależą od game_interface)"];
            
            subgraph Player_Info
                direction TB
                game_healthinfo & game_skills & game_stats_ui[game_stats] & game_outfit;
            end
            subgraph Item_Management
                direction TB
                game_inventory & game_containers & game_shop & game_market;
            end
            subgraph Interaction
                direction TB
                game_buttons & game_hotkeys & game_actionbar & game_battle;
            end
        end
        game_interface -- "jest wymagany przez" --> Moduly_UI;
    end
    client_entergame -- "uruchamia" --> game_interface;

    %% ===================================================================
    %% MODUŁY POMOCNICZE (UTILITIES)
    %% ===================================================================
    subgraph Utilities
        updater
    end
    updater -- "zależy od" --> client_locales & client_styles & client_textedit;
    
    %% ===================================================================
    %% PRZYPISANIE STYLÓW
    %% ===================================================================
    class client,game_interface core;
    class client_styles,client_locales,client_textedit,client_background,client_options,client_terminal,client_stats,client_feedback,client_mobile client_module;
    class client_entergame,game_features,game_things game_logic;
    class game_healthinfo,game_skills,game_stats_ui,game_outfit,game_inventory,game_containers,game_shop,game_market,game_buttons,game_hotkeys,game_actionbar,game_battle game_ui;
    class updater utility;
    class Warstwa_Rdzenia,Warstwa_Modułów_Klienta,Warstwa_Logiki_Gry,Świat_Gry,Utilities,Moduly_UI container;
    class note note;
