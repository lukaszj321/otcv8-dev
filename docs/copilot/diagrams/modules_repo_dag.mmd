%%{init: {"theme":"dark", "flowchart": {"curve": "stepBefore"}}}%%
graph TD
    %% ===================================================================
    %% DEFINICJE STYLÓW - HIERARCHIA WIZUALNA
    %% ===================================================================
    classDef orchestrator fill:#004a99,color:#fff,stroke:#3399ff,stroke-width:3px,font-weight:bold,font-size:16px;
    classDef module_group fill:#222,stroke:#888,stroke-dasharray: 5 5;
    classDef pregame_module fill:#5b005b,color:#fff,stroke:#ad66ad;
    classDef gamedata_module fill:#792e00,color:#fff,stroke:#c26d39;
    classDef gameui_module fill:#00504b,color:#fff,stroke:#33b3a9;
    classDef utility_module fill:#614a00,color:#fff,stroke:#a68333;
    classDef final_state fill:#006400,color:#fff,stroke:#2E8B57,stroke-width:3px,font-weight:bold;
    classDef invisible stroke-width:0px,color:#1a1a1a;

    %% ===================================================================
    %% CENTRALNA OŚ PROCESU
    %% ===================================================================
    subgraph Central_Axis [ ]
        Start("🚀 Application Start");
        client("1. Core Client Init");
        client_entergame_init("2. Enter Game Init");
        game_interface("3. Game Interface Init");
        Ready("✅ Client Ready");

        Start --> client --> client_entergame_init --> game_interface --> Ready;
    end
    style Central_Axis fill:none,stroke:none

    %% ===================================================================
    %% STREFA LEWA: MODUŁY PRE-GAME I UTILITIES
    %% ===================================================================
    subgraph Pre_Game_Zone [Pre-Game & Common Modules]
        subgraph Utilities
            updater;
        end
        subgraph PreGame_Modules
            client_styles & client_locales & client_textedit & client_background & client_options & client_terminal & client_stats & client_feedback & client_mobile & client_entergame;
        end
    end
    client -- "ładuje" --> PreGame_Modules;
    updater -- "zależy od" --> client_locales & client_styles & client_textedit;
    
    %% ===================================================================
    %% STREFA PRAWA: MODUŁY IN-GAME
    %% ===================================================================
    subgraph In_Game_Zone [In-Game Modules]
        subgraph Game_Data
            game_things & game_features;
        end
        subgraph Game_UI_Modules
            subgraph Player_Info
                game_healthinfo & game_skills & game_stats_ui[game_stats];
            end
            subgraph Item_Management
                game_inventory & game_containers & game_shop;
            end
        end
    end
    client_entergame_init -- "ładuje" --> Game_Data;
    game_interface -- "ładuje" --> Game_UI_Modules;

    %% ===================================================================
    %% KONTROLA UKŁADU - TWORZENIE TRZECH KOLUMN
    %% ===================================================================
    subgraph невидимка [ ]
      Pre_Game_Zone ~~~ Central_Axis ~~~ In_Game_Zone;
    end
    class невидимка invisible;

    %% ===================================================================
    %% PRZYPISANIE STYLÓW DO ELEMENTÓW
    %% ===================================================================
    class client,client_entergame_init,game_interface orchestrator;
    class Ready final_state;
    class Pre_Game_Zone,In_Game_Zone,Utilities,PreGame_Modules,Game_Data,Game_UI_Modules,Player_Info,Item_Management module_group;
    class client_styles,client_locales,client_textedit,client_background,client_options,client_terminal,client_stats,client_feedback,client_mobile,client_entergame pregame_module;
    class game_things,game_features gamedata_module;
    class game_healthinfo,game_skills,game_stats_ui,game_inventory,game_containers,game_shop gameui_module;
    class updater utility_module;
