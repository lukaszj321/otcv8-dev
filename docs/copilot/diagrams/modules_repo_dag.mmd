%%{init: {"theme":"dark"}}%%
graph TD
    %% = anas_definicyjne_stylow - hierarchia_wizualna
    classDef core fill:#004a99,color:#fff,stroke:#3399ff,stroke-width:2px,font-weight:bold,font-size:16px;
    classDef client_module fill:#4B0082,color:#fff,stroke:#9932CC;
    classDef game_logic fill:#792e00,color:#fff,stroke:#c26d39;
    classDef game_ui fill:#00504b,color:#fff,stroke:#33b3a9;
    classDef utility fill:#614a00,color:#fff,stroke:#a68333;
    classDef container fill:#222,stroke:#888,stroke-dasharray: 5 5;

    %% ===================================================================
    %% DEKLARACJA GŁÓWNYCH KOMPONENTÓW
    %% ===================================================================
    
    subgraph Rdzeń_Aplikacji
        client;
    end
    
    subgraph Moduły_Wspólne_i_Narzędzia
        direction LR
        subgraph Utilities
            updater;
        end
        subgraph Moduły_Pre_Game
            client_styles & client_locales & client_textedit & client_background & client_options & client_terminal & client_stats & client_feedback & client_mobile;
        end
    end

    subgraph Przepływ_Logiki_Gry
        direction TD
        client_entergame;
        subgraph Dane_Gry
            game_things & game_features;
        end
        client_entergame --> Dane_Gry;
    end

    subgraph Świat_Gry
        direction TD
        game_interface;
        subgraph Moduły_UI
            direction LR
            subgraph Player_Info
                game_healthinfo & game_skills & game_stats_ui[game_stats];
            end
            subgraph Item_Management
                game_inventory & game_containers & game_shop;
            end
        end
        game_interface -- "wymaga" --> Moduły_UI;
    end

    %% ===================================================================
    %% POŁĄCZENIA - DEFINIOWANIE ARCHITEKTURY
    %% ===================================================================
    client -- "wykorzystuje" --> Moduły_Pre_Game;
    client -- "uruchamia" --> client_entergame;
    client_entergame -- "tworzy" --> game_interface;
    
    %% Zależności updatgera
    updater -- "zależy od" --> client_locales & client_styles & client_textedit;

    %% ===================================================================
    %% PRZYPISANIE STYLÓW
    %% ===================================================================
    class client core;
    class Rdzeń_Aplikacji,Moduły_Wspólne_i_Narzędzia,Przepływ_Logiki_Gry,Świat_Gry,Utilities,Moduły_Pre_Game,Dane_Gry,Moduły_UI,Player_Info,Item_Management container;
    class client_styles,client_locales,client_textedit,client_background,client_options,client_terminal,client_stats,client_feedback,client_mobile client_module;
    class client_entergame,game_things,game_features game_logic;
    class game_interface game_logic;
    class game_healthinfo,game_skills,game_stats_ui,game_inventory,game_containers,game_shop game_ui;
    class updater utility;
